#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <ctype.h>

#define PORT 65432
#define BUFFER_SIZE 4096
#define MAX_BOOKS 4

// Structure to hold book attributes
typedef struct {
    char id[10];
    char title[100];
    char author[50];
    char category[50];
    int available; // 1 = True, 0 = False
    char issued_to[20];
} Book;

// Initialize global catalog in memory
Book catalog[MAX_BOOKS] = {
    {"101", "Introduction to Algorithms", "Cormen", "Computer Science", 1, ""},
    {"102", "Computer Networks", "Tanenbaum", "Networking", 1, ""},
    {"103", "Operating System Concepts", "Silberschatz", "Operating Systems", 0, "STU007"},
    {"104", "Clean Code", "Robert Martin", "Software Engineering", 1, ""}
};

// Helper function for case-insensitive substring search
int strstr_case(const char *haystack, const char *needle) {
    if (!haystack || !needle) return 0;
    if (strlen(needle) == 0) return 1;

    char h_lower[200], n_lower[200];
    int i;
    for (i = 0; haystack[i] && i < 199; i++) h_lower[i] = tolower(haystack[i]);
    h_lower[i] = '\0';
    
    for (i = 0; needle[i] && i < 199; i++) n_lower[i] = tolower(needle[i]);
    n_lower[i] = '\0';

    return strstr(h_lower, n_lower) != NULL;
}

void process_client(int client_sock) {
    char buffer[BUFFER_SIZE];
    char response[BUFFER_SIZE];
    int read_size;

    while ((read_size = recv(client_sock, buffer, BUFFER_SIZE - 1, 0)) > 0) {
        buffer[read_size] = '\0';
        
        // Trim newline characters from the received command string
        while(read_size > 0 && (buffer[read_size-1] == '\n' || buffer[read_size-1] == '\r')) {
            buffer[--read_size] = '\0';
        }

        // Graceful exit validation check
        if (strcmp(buffer, "exit") == 0) {
            printf("[GRACEFUL DISCONNECT] Client requested session termination.\n");
            send(client_sock, "Goodbye!", 8, 0);
            break;
        }

        // Command parsing variables
        char command[20] = {0};
        char arg1[100] = {0};
        char arg2[50] = {0};
        memset(response, 0, sizeof(response));

        // Format rules parsed: "COMMAND|ARG1|ARG2"
        sscanf(buffer, "%[^|]|%[^|]|%[^|]", command, arg1, arg2);

        // 1. SEARCH Command
        if (strcmp(command, "search") == 0) {
            strcat(response, "\nSearch Results:\n");
            int found = 0;
            for (int i = 0; i < MAX_BOOKS; i++) {
                if (strstr_case(catalog[i].id, arg1) || 
                    strstr_case(catalog[i].title, arg1) || 
                    strstr_case(catalog[i].author, arg1)) {
                    
                    char line[256];
                    sprintf(line, "ID: %s | Title: %s | Author: %s | Cat: %s | Avail: %s\n",
                            catalog[i].id, catalog[i].title, catalog[i].author, catalog[i].category,
                            catalog[i].available ? "Yes" : "No");
                    strcat(response, line);
                    found = 1;
                }
            }
            if (!found) strcpy(response, "No matching records found.\n");
        }
        
        // 2. CHECK AVAILABILITY Command
        else if (strcmp(command, "check") == 0) {
            int found = 0;
            for (int i = 0; i < MAX_BOOKS; i++) {
                if (strcmp(catalog[i].id, arg1) == 0) {
                    found = 1;
                    if (catalog[i].available) {
                        sprintf(response, "Book '%s' is AVAILABLE.\n", catalog[i].title);
                    } else {
                        sprintf(response, "Book '%s' is RESERVED/ISSUED to %s.\n", catalog[i].title, catalog[i].issued_to);
                    }
                    break;
                }
            }
            if (!found) strcpy(response, "Book ID invalid / not found.\n");
        }
        
        // 3. ISSUE BOOK Command
        else if (strcmp(command, "issue") == 0) {
            int found = 0;
            for (int i = 0; i < MAX_BOOKS; i++) {
                if (strcmp(catalog[i].id, arg1) == 0) {
                    found = 1;
                    if (catalog[i].available) {
                        catalog[i].available = 0;
                        strcpy(catalog[i].issued_to, arg2);
                        sprintf(response, "SUCCESS: Book '%s' has been issued to %s.\n", catalog[i].title, arg2);
                    } else {
                        strcpy(response, "FAIL: Book is already checked out by another student.\n");
                    }
                    break;
                }
            }
            if (!found) strcpy(response, "Book ID invalid / not found.\n");
        }
        
        // 4. RETURN BOOK Command
        else if (strcmp(command, "return") == 0) {
            int found = 0;
            for (int i = 0; i < MAX_BOOKS; i++) {
                if (strcmp(catalog[i].id, arg1) == 0) {
                    found = 1;
                    if (!catalog[i].available) {
                        catalog[i].available = 1;
                        sprintf(response, "SUCCESS: Book '%s' returned safely. Clearing ledger.\n", catalog[i].title);
                        strcpy(catalog[i].issued_to, "");
                    } else {
                        strcpy(response, "FAIL: This book is already present in library shelves.\n");
                    }
                    break;
                }
            }
            if (!found) strcpy(response, "Book ID invalid / not found.\n");
        }
        
        // 5. VIEW ALL ISSUED BOOKS Command
        else if (strcmp(command, "view") == 0) {
            strcat(response, "\nCurrently Leased Records:\n");
            int found = 0;
            for (int i = 0; i < MAX_BOOKS; i++) {
                if (!catalog[i].available) {
                    char line[256];
                    sprintf(line, "ID: %s | Title: %s | Checked Out By: %s\n", catalog[i].id, catalog[i].title, catalog[i].issued_to);
                    strcat(response, line);
                    found = 1;
                }
            }
            if (!found) strcpy(response, "Clear catalog desk. Zero issued books items found.\n");
        }
        
        else {
            strcpy(response, "Error: Unknown query operation matrix requested.\n");
        }

        // Send computed transactional message response back
        send(client_sock, response, strlen(response), 0);
    }

    if (read_size == 0) {
        printf("[DISCONNECTED] Client socket endpoint abruptly disconnected.\n");
    } else if (read_size == -1) {
        perror("recv failed");
    }
}

int main() {
    int server_fd, client_sock;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_size = sizeof(client_addr);

    // Create Socket Descriptor
    server_fd = socket(AF_INET, socket.SOCK_STREAM, 0);
    if (server_fd < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    // Set Option to re-use port immediately
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    // Bind socket
    if (bind(server_fd, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    // Set Listen backlog to 5 slots
    if (listen(server_fd, 5) < 0) {
        perror("Listen failed");
        close(server_fd);
        exit(EXIT_FAILURE);
    }

    printf("[SERVER STARTED] Iterative C Server online. Port: %d...\n", PORT);

    // Main Iterative loop structure (1 Client thread execution block sequentially)
    while (1) {
        printf("\n[WAITING] Awaiting connection arrival on pipeline...\n");
        client_sock = accept(server_fd, (struct sockaddr*)&client_addr, &addr_size);
        if (client_sock < 0) {
            perror("Accept failed");
            continue;
        }
        printf("[CONNECTED] Handling connection request from %s:%d\n", 
               inet_ntoa(client_addr.sin_addr), ntohs(client_addr.sin_port));

        // Process current client completely before looping back to accept()
        process_client(client_sock);

        close(client_sock);
        printf("[CLOSED] Connection terminated gracefully. Re-allocating listening pipeline channels.\n");
    }

    close(server_fd);
    return 0;
}

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 65432
#define BUFFER_SIZE 4096

void clean_stdin() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

int main() {
    int sock;
    struct sockaddr_in server_addr;
    char buffer[BUFFER_SIZE];
    char payload[BUFFER_SIZE];
    int choice;

    sock = socket(AF_INET, socket.SOCK_STREAM, 0);
    if (sock < 0) {
        perror("Socket allocation failure");
        exit(EXIT_FAILURE);
    }

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(sock, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0) {
        perror("Connection connection path refused");
        close(sock);
        exit(EXIT_FAILURE);
    }
    printf("[CONNECTED] Established structural link to library server pipeline.\n");

    while (1) {
        printf("\n=== C LIBRARY CLIENT MENU ===\n");
        printf("1. Search Books (Keyword / Match Index)\n");
        printf("2. Check Book Availability Flag\n");
        printf("3. Request Book Allocation (Issue)\n");
        printf("4. Return Borrowed Book Assets\n");
        printf("5. View Ledger (All Issued Items)\n");
        printf("6. Terminate Session gracefully\n");
        printf("Provide processing index (1-6): ");
        
        if (scanf("%d", &choice) != 1) {
            printf("Invalid digit format.\n");
            clean_stdin();
            continue;
        }
        clean_stdin(); // Flush newlines from input channel stream

        memset(payload, 0, sizeof(payload));

        if (choice == 1) {
            char query[50];
            printf("Enter search keyword (ID/Title/Author): ");
            fgets(query, sizeof(query), stdin);
            query[strcspn(query, "\n")] = 0; // Strip trailing character
            sprintf(payload, "search|%s|", query);
        } 
        else if (choice == 2) {
            char bid[10];
            printf("Enter Book ID payload value: ");
            scanf("%s", bid);
            sprintf(payload, "check|%s|", bid);
        } 
        else if (choice == 3) {
            char bid[10], sid[20];
            printf("Target Book ID string: ");
            scanf("%s", bid);
            printf("Issuer Student ID: ");
            scanf("%s", sid);
            sprintf(payload, "issue|%s|%s", bid, sid);
        } 
        else if (choice == 4) {
            char bid[10];
            printf("Enter Book ID to declare as returned: ");
            scanf("%s", bid);
            sprintf(payload, "return|%s|", bid);
        } 
        else if (choice == 5) {
            sprintf(payload, "view||");
        } 
        else if (choice == 6) {
            strcpy(payload, "exit");
        } 
        else {
            printf("Selection parameters out of bounds limit.\n");
            continue;
        }

        // Send payload structure string
        send(sock, payload, strlen(payload), 0);

        // Await server structural transaction return response
        int server_bytes = recv(sock, buffer, BUFFER_SIZE - 1, 0);
        if (server_bytes <= 0) {
            printf("Server dropped network stream.\n");
            break;
        }
        buffer[server_bytes] = '\0';
        printf("\n--- Server Transmission Output ---\n%s", buffer);

        if (choice == 6) {
            break; // Break the infinite client workflow cycle structure loop
        }
    }

    close(sock);
    printf("\n[OFFLINE] Connection line closed safely.\n");
    return 0;
}
