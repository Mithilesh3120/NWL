#include <string.h>
#include <limits.h> // Fixed C header

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    int adj[101][101];
    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= n; j++) {
            adj[i][j] = (i == j) ? 0 : -1;
        }
    }
    
    for (int i = 0; i < timesSize; i++) {
        adj[times[i][0]][times[i][1]] = times[i][2];
    }
    
    int dist[101];
    int visited[101] = {0};
    for (int i = 1; i <= n; i++) dist[i] = INT_MAX;
    
    dist[k] = 0;
    
    for (int count = 0; count < n; count++) {
        int u = -1, min_dist = INT_MAX;
        for (int i = 1; i <= n; i++) {
            if (!visited[i] && dist[i] < min_dist) {
                min_dist = dist[i];
                u = i;
            }
        }
        
        if (u == -1) break;
        visited[u] = 1;
        
        for (int v = 1; v <= n; v++) {
            if (!visited[v] && adj[u][v] != -1 && dist[u] != INT_MAX) {
                if (dist[u] + adj[u][v] < dist[v]) {
                    dist[v] = dist[u] + adj[u][v];
                }
            }
        }
    }
    
    int max_delay = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INT_MAX) return -1;
        if (dist[i] > max_delay) max_delay = dist[i];
    }
    
    return max_delay;
}
